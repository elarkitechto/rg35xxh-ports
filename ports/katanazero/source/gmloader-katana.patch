     REGISTER_STATIC_METHOD(RunnerJNILib, OsGetInfo, "()I"),
     REGISTER_STATIC_METHOD(RunnerJNILib, GamepadAxesValues, "(I)[F"),
     REGISTER_STATIC_METHOD(RunnerJNILib, MoveTaskToBack, "()V"),
