+jobject RunnerJNILib::KatanaExtensionTrace(JNIEnv *env, jclass clz, jstring extension, jstring method, jint argc, jdoubleArray numbers, jobjectArray objects)
+{
+    if (getenv("KATANA_EXTENSION_TRACE")) {
+        const char *ext = extension ? env->GetStringUTFChars(extension, NULL) : "<null>";
+        const char *name = method ? env->GetStringUTFChars(method, NULL) : "<null>";
+        fprintf(stderr, "KATANA_EXTENSION %s.%s argc=%d\n", ext, name, argc);
+    }
+    if (getenv("KATANA_UNLOCKED_COMPAT") && extension && method) {
+        const char *ext = env->GetStringUTFChars(extension, NULL);
+        const char *name = env->GetStringUTFChars(method, NULL);
+        if (!strcmp(ext, "NetflixIntegration")) {
+            if (!strcmp(name, "NfxaShowUI")) {
+                int map = CreateDsMap(0);
+                dsMapAddString(map, "type", "Nfx_onPlayerAccessRequest");
+                dsMapAddString(map, "playerID", "local");
+                CreateAsynEventWithDSMap(map, 70);
+                return NULL;
+            }
+            if (!strcmp(name, "NfxaCloudRead") || !strcmp(name, "NfxaCloudWrite")) {
+                jobject keyobj = objects && argc > 0 ? env->GetObjectArrayElement(objects, 0) : NULL;
+                const char *key = keyobj ? env->GetStringUTFChars((jstring)keyobj, NULL) : "";
+                std::string safe;
+                for (const unsigned char c : std::string(key)) safe += (isalnum(c) || c == '_' || c == '-') ? char(c) : '_';
+                const char *root = getenv("KATANA_LOCAL_SAVE_DIR");
+                std::string dir = root ? root : "save/katana-local";
+                mkdir(dir.c_str(), 0755);
+                std::string path = dir + "/" + safe + ".dat";
+                bool writing = !strcmp(name, "NfxaCloudWrite");
+                int error = 0;
+                std::string data;
+                if (safe.empty()) error = -1;
+                else if (writing) {
+                    jobject value = objects && argc > 1 ? env->GetObjectArrayElement(objects, 1) : NULL;
+                    const char *text = value ? env->GetStringUTFChars((jstring)value, NULL) : "";
+                    std::ofstream file(path + ".tmp", std::ios::binary | std::ios::trunc);
+                    file << text;
+                    file.close();
+                    if (!file || rename((path + ".tmp").c_str(), path.c_str())) error = -1;
+                } else {
+                    std::ifstream file(path, std::ios::binary);
+                    data.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+                }
+                fprintf(stderr, "KATANA_LOCAL_SAVE %s slot=%s error=%d bytes=%zu\n", writing ? "write" : "read", safe.c_str(), error, data.size());
+                int map = CreateDsMap(0);
+                dsMapAddString(map, "type", writing ? "Nfx_cloudWrite" : "Nfx_cloudRead");
+                dsMapAddDouble(map, "error", error);
+                if (!writing) dsMapAddString(map, "string", data.c_str());
+                CreateAsynEventWithDSMap(map, 70);
+                return (jobject)new KatanaDouble(1.0);
+            }
+            if (!strcmp(name, "NfxaInit")) return (jobject)new KatanaDouble(1.0);
+            if (!strcmp(name, "NfxaGetPlayerID")) return (jobject)new String("local");
+            if (!strcmp(name, "NfxaGetLocale")) return (jobject)new String("en");
+            if (!strcmp(name, "NfxaGetGameHandle")) return (jobject)new String("Player");
+        }
+    }
+    return NULL;
+}
+
 const ManagedMethod RunnerJNILibManagedMethods[] = {
