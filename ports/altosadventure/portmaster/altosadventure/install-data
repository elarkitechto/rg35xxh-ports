#!/bin/sh
# Called automatically by the only top-level game launcher; never run manually.
set -eu
PORTDIR=$1
LAB=${ALTO_RUNTIME_DIR:-$PORTDIR/runtime}
DATA=${ALTO_DATA_DIR:-$PORTDIR/gamedata}
APK="$PORTDIR/altos-adventure-1-8-8.apk"
EXPECTED=efb8eb2054e6c66173fc1638e6d005f048b48446b6029c4fdcb8aa8b9dcaaae0
fail() { echo "Alto's Adventure: $*" >&2; exit 1; }
mkdir -p "$LAB" "$DATA"
for name in alto-loader libOpenSLES.so; do
 [ -s "$LAB/$name" ] || fail "missing bundled runtime/$name; reinstall the port package"
done
if [ "$(cat "$DATA/.alto-apk.sha256" 2>/dev/null || true)" = "$EXPECTED" ] &&
   [ -s "$DATA/assets/bin/Data/data.unity3d" ] &&
   [ -s "$DATA/assets/bin/Data/Managed/Metadata/global-metadata.dat" ] &&
   [ -s "$LAB/libunity.so" ] && [ -s "$LAB/libil2cpp.so" ]; then
 echo 'Game files already installed.'
 exit 0
fi
(cd "$LAB" && sha256sum -c runtime.sha256) || fail 'port runtime is missing or damaged'
[ -f "$APK" ] || fail "copy altos-adventure-1-8-8.apk into $PORTDIR and launch again"
[ "$(sha256sum "$APK" | cut -d ' ' -f 1)" = "$EXPECTED" ] || fail 'wrong APK; Alto 1.8.8 with the documented SHA-256 is required'
STAGE=$(mktemp -d "$PORTDIR/.alto-install.XXXXXX")
trap 'rm -rf "$STAGE"' 0 HUP INT TERM
unzip -oq "$APK" 'assets/*' 'lib/arm64-v8a/libil2cpp.so' 'lib/arm64-v8a/libunity.so' -d "$STAGE"
[ -s "$STAGE/assets/bin/Data/data.unity3d" ] || fail 'Unity assets missing'
[ -s "$STAGE/assets/bin/Data/Managed/Metadata/global-metadata.dat" ] || fail 'IL2CPP metadata missing'
(cd "$STAGE/lib/arm64-v8a" && sha256sum -c "$PORTDIR/alto-libraries.sha256") || fail 'unexpected Unity libraries'
if [ -d "$DATA/assets" ]; then
 cmp -s "$DATA/assets/bin/Data/data.unity3d" "$STAGE/assets/bin/Data/data.unity3d" || fail 'existing assets differ; refusing to replace them'
 cmp -s "$DATA/assets/bin/Data/Managed/Metadata/global-metadata.dat" "$STAGE/assets/bin/Data/Managed/Metadata/global-metadata.dat" || fail 'existing metadata differs'
else
 mv "$STAGE/assets" "$DATA/assets"
fi
for name in libil2cpp.so libunity.so; do
 cp "$STAGE/lib/arm64-v8a/$name" "$LAB/$name.next"
 mv "$LAB/$name.next" "$LAB/$name"
done
printf '%s\n' "$EXPECTED" > "$DATA/.alto-apk.sha256"
chmod +x "$LAB/alto-loader"
ANALYTICS="$DATA/userdata/Unity/7bf5b486-0476-4fb9-ba7c-21599d55fdd6/Analytics"
mkdir -p "$ANALYTICS"
printf '%s\n' '{"analytics":{"enabled":false},"connect":{"enabled":false,"player_opted_out":true,"limit_user_tracking":true},"performance":{"enabled":false}}' > "$ANALYTICS/config"
echo "Alto's Adventure: ready."
