#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
sh "$root/tools/check-public-tree.sh"
sh -n "$root/ports/crossyroad/portmaster/Crossy Road.sh" "$root/ports/crossyroad/portmaster/crossyroad/install-data" "$root/ports/crossyroad/source/build_native.sh" "$root/tools/build-crossyroad-local.sh"
python3 -m json.tool "$root/ports/crossyroad/portmaster/port.json" >/dev/null

sh -n "$root/tools/build-alto-local.sh"
sh -n "$root/ports/altosadventure/source/build.sh"
sh -n "$root/ports/altosadventure/portmaster/altosadventure/install-data"
bash -n "$root/ports/altosadventure/portmaster/Alto's Adventure.sh"
python3 -m json.tool "$root/ports/altosadventure/portmaster/port.json" >/dev/null
python3 -c "import xml.etree.ElementTree as E; E.parse('$root/ports/altosadventure/portmaster/gameinfo.xml')"

python3 -m py_compile "$root/tools/validate-port-media.py"

python3 "$root/ports/altosadventure/tests/test_launcher.py"

sh -n "$root/ports/crossyroad/source/build_all.sh"
python3 "$root/ports/crossyroad/tests/test_launcher.py"

bash -n "$root/ports/threes/portmaster/Threes!.sh"
sh -n "$root/ports/threes/portmaster/threes/install-data" "$root/ports/threes/source/build.sh" "$root/tools/build-threes-local.sh"
python3 -m json.tool "$root/ports/threes/portmaster/port.json" >/dev/null
python3 -m unittest discover -s "$root/ports/threes/tests"

python3 -m unittest discover -s "$root/tools/tests"

# Monument Valley final package sources and metadata.
bash -n "$root/ports/monumentvalley/portmaster/Monument Valley.sh"
sh -n "$root/ports/monumentvalley/portmaster/monumentvalley/install-data" "$root/ports/monumentvalley/source/build.sh" "$root/tools/build-monumentvalley-local.sh"
python3 -m json.tool "$root/ports/monumentvalley/portmaster/port.json" >/dev/null
python3 -c "import xml.etree.ElementTree as E; E.parse('$root/ports/monumentvalley/portmaster/gameinfo.xml')"
